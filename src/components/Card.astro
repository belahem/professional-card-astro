---
//src/components/Card.astro
const {name, position, aboutMe, path, instagram, github, youtube, cvLink, profileImage } = Astro.props;

import '../styles/card.css';
---

<div class="container">
    <div class="card-container">
        <div class="descripcion">
            <h1>{name}</h1>
            <h2>{position}</h2>
            <p>{aboutMe}</p>
            <div class="icons">
                <a href={path} class="hover-text" target="_blank">
                    <span class="tooltip-text" id="fade">
                        Path
                    </span>
                    <img src="/images/path.png" alt="Path" />
                </a>
                <a href={instagram} class="hover-text" target="_blank">
                    <span class="tooltip-text" id="fade">
                        Instagram
                    </span>
                    <i class="bi bi-instagram"></i>
                </a>
                <a href={github} class="hover-text" target="_blank">
                    <span class="tooltip-text" id="fade">
                        GitHub
                    </span>
                    <i class="bi bi-github"></i>
                </a>
                <a href={youtube} class="hover-text" target="_blank">
                    <span class="tooltip-text" id="fade">
                        Youtube
                    </span>
                    <i class="bi bi-youtube"></i>
                </a>
<!--    <hilangkan cv sementara>
                <a href={cvLink} class="hover-text" target="_blank">
                    <span class="tooltip-text" id="fade">
                        Resume
                    </span>
                    <i class="bi bi-file-earmark-arrow-down"></i>
                </a>
-->
            </div>
        </div>
        <div class="image">
            <img src={profileImage} alt="">
        </div>
    </div>
</div>
