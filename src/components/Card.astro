---
//src/components/Card.astro
const {name, position, aboutMe, path, instagram, github, youtube, cvLink, profileImage } = Astro.props;

import '../styles/card.css';
---

<div class="container">
    <div class="card-container">
        <div class="descripcion">
            <h1>{name}</h1>
            <h2>{position}</h2>
            <p>{aboutMe}</p>
            <div class="icons">
                <a href={path} class="hover-text" target="_blank">
                    <span class="tooltip-text" id="fade">
                        Path
                    </span>
                    <a href={path} class="hover-text" target="_blank">
                    <span class="tooltip-text" id="fade">
                        Path
                    </span>
                    <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 97.444 97.444" fill="currentColor" style="vertical-align: -0.125em;" aria-hidden="true">
                        <path d="M94.271,29.14c-1.568-5.978-4.543-11.01-9.327-15.778C78.048,6.49,69.653,2.605,57.339,0.582c-4.281-0.7-14.521-0.789-18.114-0.152C25.811,2.8,16.182,8.291,9.582,17.329c-2.237,3.063-4.85,8.541-5.862,12.285c-0.808,2.996-1.561,5.109-1.561,10.557c0,5.448,0.933,10.038,3.19,14.649c1.351,2.758,4.212,6.846,5.247,7.5c0.416,0.264,1.633-0.635,6.521-4.818l6.007-5.141l-1.095-1.281c-2.296-2.683-3.348-6.229-3.326-11.49c0.025-6.458,1.952-11.079,6.517-15.635c3.072-3.064,6.548-5.211,10.795-6.664c11.228-3.846,25.878-1.952,34.326,4.437c3.774,2.853,6.889,7.715,7.83,12.224c0.625,2.994,0.608,8.36-0.033,10.76c-2.002,7.489-8.955,12.743-17.612,13.312c-3.109,0.206-7.486-0.271-9.25-1.013l-1.024-0.425V41.92V27.254H42.07h-8.181L33.8,53.007c-0.088,25.243-0.103,25.778-0.729,26.858c-1.678,2.885-6.534,2.965-10.739,0.174l-1.694-1.127l-0.011,14.74c0.953,1.358,5.046,2.959,8.442,3.527c2.354,0.396,6.003,0.342,8.647-0.131c5.915-1.055,9.395-4.129,11.49-10.15c0.82-2.355,0.864-2.791,0.98-9.822c0.123-7.351,0.123-7.355,0.802-7.178c0.374,0.096,1.741,0.479,3.042,0.848c16.979,2.602,25.271-3.356,31.684-9.312c5.053-4.943,7.739-9.678,9.027-15.905C95.627,41.244,95.405,33.463,94.271,29.14z"/>
                    </svg>
                </a>
                </a>
                <a href={instagram} class="hover-text" target="_blank">
                    <span class="tooltip-text" id="fade">
                        Instagram
                    </span>
                    <i class="bi bi-instagram"></i>
                </a>
                <a href={github} class="hover-text" target="_blank">
                    <span class="tooltip-text" id="fade">
                        GitHub
                    </span>
                    <i class="bi bi-github"></i>
                </a>
                <a href={youtube} class="hover-text" target="_blank">
                    <span class="tooltip-text" id="fade">
                        Youtube
                    </span>
                    <i class="bi bi-youtube"></i>
                </a>
<!--    <hilangkan cv sementara>
                <a href={cvLink} class="hover-text" target="_blank">
                    <span class="tooltip-text" id="fade">
                        Resume
                    </span>
                    <i class="bi bi-file-earmark-arrow-down"></i>
                </a>
-->
            </div>
        </div>
        <div class="image">
            <img src={profileImage} alt="">
        </div>
    </div>
</div>
